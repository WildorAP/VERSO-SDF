# =============================================================================
# VERSO Stellar Anchor — environment variables
# Local: copy to backend/.env
# Railway: set each variable in the dashboard (never commit .env)
# =============================================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Polaris (required) ---
# Tranche 1: SEP-1 + SEP-10. Etapa 2 adds sep-38; Etapa 3 adds sep-24.
ACTIVE_SEPS=sep-1,sep-10,sep-38,sep-24
HOST_URL=http://localhost:8000
LOCAL_MODE=1
ENABLE_SEP_0023=1

# Stellar testnet signing key
# python -c "from stellar_sdk import Keypair; print(Keypair.random().secret)"
SIGNING_SEED=S_REPLACE_WITH_TESTNET_SECRET_KEY
SERVER_JWT_KEY=replace-with-random-secret-at-least-32-chars

SEP10_HOME_DOMAINS=localhost,127.0.0.1,versotek.io
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Horizon REST API — used by django-polaris workers (watch_transactions, process_pending_deposits, …).
# Polaris default if unset: https://horizon-testnet.stellar.org (see polaris/settings.py).
# MUST be set explicitly when STELLAR_NETWORK_PASSPHRASE is mainnet — changing the passphrase alone
# does NOT switch Polaris to mainnet Horizon.
# HORIZON_URI=https://horizon-testnet.stellar.org
# Mainnet (T3):
# HORIZON_URI=https://horizon.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# --- Database ---
# Local (default): leave DATABASE_URL empty → SQLite (backend/db.sqlite3)
# Local Postgres: docker compose up -d, then uncomment:
# DATABASE_URL=postgres://verso:verso@localhost:5432/verso_anchor
# Railway production: DATABASE_URL=${{Postgres.DATABASE_URL}} on the web service

# --- VERSO Core API (BASE_DE_CLIENTES) — T1+ ---
# Local dev without Core: mock on :9000 returning {"rate_venta":"3.5000","rate_compra":"3.4000"}
# Full Etapa 4 stack: point at DJANGO_RAIL on :8001
VERSO_CORE_API_URL=http://127.0.0.1:8001
VERSO_CORE_API_KEY=local-dev

# Firm SEP-38 quote lifetime in seconds (default 180 = 3 min; see README "Quote expiration window").
# VERSO_QUOTE_TTL_SECONDS=180

# --- Redis (SEP-24 sessions — T2 Etapa 1+) ---
# Local: docker compose up -d (redis service on 6379)
REDIS_URL=redis://localhost:6379/0

# --- CCI/CCE Perú — depósitos SEP-24 (solo bancos peruanos, sin wire/SWIFT) ---
# CCI para soles (PEN):
# VERSO_CCI_BANK_NAME=BCP
# VERSO_CCI_ACCOUNT_NUMBER=
# VERSO_CCI_ACCOUNT_HOLDER=VERSO PERU
# CCI distinto para dólares (USD):
# VERSO_USD_CCI_BANK_NAME=BCP
# VERSO_USD_CCI_ACCOUNT_NUMBER=
# VERSO_USD_CCI_ACCOUNT_HOLDER=VERSO PERU

# --- SEP-24 onboarding / KYC gate (Etapa 4) ---
# Force KYC status without Core lookup (tests/dev). Values: approved|not_found|pending|rejected
# Leave empty in production — live status comes from GET /internal/users/status/ via session email.
# VERSO_MOCK_KYC=
# After email verification, skip DIDIT in LOCAL_MODE (session approves KYC for deposit form).
# VERSO_MOCK_KYC_AUTO_APPROVE_AFTER_VERIFY=1
# Test-only: auto-confirm PEN after webview (never enable in production).
# VERSO_MOCK_AUTO_CONFIRM_FIAT=0
# Test-only: auto-mark fiat payout sent after payout CCI form (never enable in production).
# VERSO_MOCK_AUTO_SEND_FIAT=0
# Dev-only: allow completing withdraw in admin without inbound USDC (never in production).
# VERSO_MOCK_COMPLETE_WITHDRAW_WITHOUT_USDC=0
#
# Production workers — separate Railway services (see README "Production workers (Railway)"):
#   DEPOSITO:       cd backend && python manage.py process_pending_deposits --loop
#   RETIRO:         cd backend && python manage.py watch_transactions
#   RECONCILIATION: cd backend && python manage.py reconciliation_worker --loop  (after bootstrap)
# Optional off-ramp helpers: execute_outgoing_transactions --loop, poll_outgoing_transactions --loop

# D3 — USDC reconciliation (Stellar RPC getEvents)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# RECON_HOT_WALLET=                         # defaults to SIGNING_SEED public key
# RECON_POLL_SECONDS=5
# RECON_INTERVAL_SECONDS=60
# RECON_MATCH_GRACE_SECONDS=600
# RECON_MAX_STALE_SECONDS=300
# RECON_ALERT_BACKEND=log                   # log | cloudwatch
# RECON_CLOUDWATCH_NAMESPACE=VERSO/AnchorReconciliation
# RECON_ENV=testnet
# RECON_SNS_TOPIC_ARN=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# Railway production (set in dashboard — Postgres + Polaris vars)
# =============================================================================
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DEBUG=False
# HOST_URL=https://anchor.versotek.io
# LOCAL_MODE=0
# ALLOWED_HOSTS=anchor.versotek.io,.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://anchor.versotek.io
# SEP10_HOME_DOMAINS=versotek.io,anchor.versotek.io
